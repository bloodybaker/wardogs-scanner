<Window x:Class="Wardogs.Scanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARDOGS — перевірка ПК" Width="960" Height="720" MinWidth="820" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Ink}" FontFamily="{StaticResource EUkraine}">
  <Window.Resources>
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="44" ShadowDepth="14" Opacity="0.48" Color="#000000"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.30" Color="#02050A"/>
    <Style x:Key="WindowControl" TargetType="Button">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#AAB3C0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B2432"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CodeInput" TargetType="TextBox">
      <Setter Property="Height" Value="58"/><Setter Property="Padding" Value="18,0"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#F8FAFD"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#0B111B"/><Setter Property="BorderBrush" Value="#263143"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="InputBorder" Property="Background" Value="#0E1623"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ConsentCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DDE3EC"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="CheckCard" Background="#0C121C" BorderBrush="#202A39" BorderThickness="1" CornerRadius="12" Padding="13,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5" Background="#121B28" BorderBrush="#445065" BorderThickness="1"><Path x:Name="Tick" Data="M 3 8 L 7 12 L 15 4" Stroke="#071019" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckCard" Property="BorderBrush" Value="#3B4659"/><Setter TargetName="CheckCard" Property="Background" Value="#101824"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="CheckCard" Property="BorderBrush" Value="#5B563A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="56"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#090D13"/><Setter Property="FontFamily" Value="{StaticResource EUkraine}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="15"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="14"><Grid><Border Height="1" VerticalAlignment="Top" Margin="18,1" Background="#FFF5B3" Opacity="0.75"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#FFE467"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#E8C12C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="22" CornerRadius="25" BorderBrush="#263044" BorderThickness="1" Effect="{StaticResource WindowShadow}">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#090D14" Offset="0"/><GradientStop Color="#0D1420" Offset="0.58"/><GradientStop Color="#101927" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid ClipToBounds="True">
      <Ellipse Width="470" Height="470" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-250,0,0,-275" Fill="#152D69A9" IsHitTestVisible="False"/>
      <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-250,-190,0" Fill="#18FFD83D" IsHitTestVisible="False"/>
      <Grid><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="26,0,20,0" MouseLeftButtonDown="TitleBarMouseDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/wardogs-ua-logo.png" Width="36" Height="36" Stretch="Uniform"/><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="ПЕРШИЙ УКРАЇНСЬКИЙ" FontWeight="Bold" FontSize="12"/><TextBlock Text="WARDOGS.COM.UA" Foreground="#6F7C8D" FontSize="9" Margin="0,2,0,0"/></StackPanel></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource WindowControl}" Content="—" Click="MinimizeClick" ToolTip="Згорнути"/><Button Style="{StaticResource WindowControl}" Content="×" Click="CloseClick" ToolTip="Закрити" Margin="5,0,0,0"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="52,18,52,48"><Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
          <Grid Margin="0,12,52,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Width="110" Height="28" HorizontalAlignment="Left" Background="#172132" BorderBrush="#2B3850" BorderThickness="1" CornerRadius="14"><TextBlock Text="АПЕЛЯЦІЯ" Foreground="#C2CAD6" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Чесна перевірка.&#10;Приватний процес." FontSize="37" FontWeight="Bold" LineHeight="45" TextWrapping="Wrap"/><Border Width="58" Height="4" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,22,0,20"/><TextBlock Text="Одноразова діагностика для розгляду апеляції. Без доступу до листування, паролів, фотографій або приватних документів." Foreground="#9AA6B6" FontSize="14" LineHeight="23" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="2"><Button Content="Політика приватності" Click="PrivacyClick" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#55D68A" Margin="0,0,9,0"/><TextBlock Text="Зашифроване з’єднання" Foreground="#8E9AAB" FontSize="11"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse Width="7" Height="7" Fill="#55D68A" Margin="0,0,9,0"/><TextBlock Text="Одноразовий доступ · 30 хвилин" Foreground="#8E9AAB" FontSize="11"/></StackPanel></StackPanel>
          </Grid>
          <Border Grid.Column="1" Background="#D90C121C" BorderBrush="#283346" BorderThickness="1" CornerRadius="22" Padding="30,22" Effect="{StaticResource CardShadow}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Перевірка ПК" FontWeight="Bold" FontSize="24"/><TextBlock Text="Введіть код, отриманий від адміністратора" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
              <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="ОДНОРАЗОВИЙ КОД" Foreground="#7F8B9C" FontSize="9" FontWeight="Bold" Margin="3,0,0,7"/><TextBox x:Name="OneTimeCode" Style="{StaticResource CodeInput}" MaxLength="140" SpellCheck.IsEnabled="False" PreviewKeyDown="CodeKeyDown" TextChanged="InputsChanged" ToolTip="Вставте одноразовий код повністю"/></StackPanel>
              <StackPanel Grid.Row="2" Margin="0,14,0,0"><CheckBox x:Name="ConsentProcesses" Style="{StaticResource ConsentCheck}" Content="Процеси, доступ до гри та макроси" Checked="InputsChanged" Unchecked="InputsChanged"/><CheckBox x:Name="ConsentSystem" Style="{StaticResource ConsentCheck}" Content="Системні сліди, історія й ідентифікатор ПК" Checked="InputsChanged" Unchecked="InputsChanged"/><CheckBox x:Name="ConsentTransfer" Style="{StaticResource ConsentCheck}" Content="Надіслати технічний звіт WARDOGS" Checked="InputsChanged" Unchecked="InputsChanged"/></StackPanel>
              <TextBlock Grid.Row="3" Text="У звіт: URL і дати лише знайдених збігів, ознаки макросів, технічні сліди та хеш ПК. Командні рядки аналізуються локально. Стороння історія, паролі й cookies не передаються. WARDOGS можна залишити відкритим." Foreground="#7F8B9C" FontSize="9" LineHeight="14" TextWrapping="Wrap" Margin="2,8,2,9" Padding="0,1,0,2"/>
              <Button Grid.Row="4" x:Name="StartButton" Content="ПОЧАТИ ПЕРЕВІРКУ" Style="{StaticResource PrimaryButton}" Click="StartClick" IsEnabled="False"/>
              <StackPanel Grid.Row="5" Margin="0,11,0,0" MinHeight="24"><TextBlock x:Name="Status" Text="Очікуємо одноразовий код" Foreground="#AAB5C4" FontSize="11" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="3" Margin="0,7,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#1B2533" BorderThickness="0"/></StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
